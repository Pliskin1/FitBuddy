{
  "name": "fitbuddy",
  "version": "0.1.0",
  "private": true,
  "description": "FitBuddy – platforma za personalne trenere i njihove klijente (monorepo)",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "preview": "npm run preview -w frontend",
    "typecheck": "npm run typecheck -w frontend",
    "check": "npm run typecheck && npm run format:check && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
