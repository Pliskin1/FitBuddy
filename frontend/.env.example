# Kopiraj u .env.local i prilagodi.

# true = API pozive presreće MSW (mock rute iz features/*/api/*.mock.ts)
# false = pozivi idu na pravi backend (VITE_API_URL)
VITE_USE_MOCKS=true

# Osnovna adresa API-ja. Sa mockovima ostaje /api.
VITE_API_URL=/api

# Raspon simuliranog kašnjenja mock odgovora (ms), da se vide loaderi.
VITE_MOCK_DELAY_MIN_MS=350
VITE_MOCK_DELAY_MAX_MS=900
